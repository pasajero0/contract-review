# Optional. Copy to `.env` to change these values; without it the same defaults apply.
# None of these is a secret.

# Where the API listens.
API_HOST=127.0.0.1
API_PORT=3001

# Where the web app's proxy finds the API.
API_URL=http://127.0.0.1:3001

# The SQLite file. A relative path starts from apps/api when run with `pnpm dev`.
LEX_DB_PATH=lex-poc.db
